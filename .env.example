# cpmf-rpachallenge Configuration Example
#
# This library reads from environment variables, NOT from .env files directly.
# To use .env files, load them in your application with python-dotenv:
#
#   from dotenv import load_dotenv
#   load_dotenv()
#   from cpmf_rpachallenge import get_config
#
# Copy this file to .env and uncomment/customize as needed.

# Base URL for rpachallenge.com
#RPACHALLENGE_BASE_URL=https://rpachallenge.com

# URL to download challenge Excel file
#RPACHALLENGE_EXCEL_URL=https://rpachallenge.com/assets/downloadFiles/challenge.xlsx

# Run browser in headless mode (true/false)
# Set to false for debugging to see the browser
#RPACHALLENGE_HEADLESS=true

# Default timeout in milliseconds
#RPACHALLENGE_TIMEOUT_MS=30000

# Directory for downloaded files (leave unset for temp directory)
#RPACHALLENGE_DOWNLOAD_DIR=

# Slow down operations by this many milliseconds (useful for debugging)
# Set to e.g. 100 to see each action
#RPACHALLENGE_SLOW_MO=0
